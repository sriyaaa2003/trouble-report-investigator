# Copy to .env. All optional.
# INVESTIGATOR_DATA_DIR=data/mozilla
# INVESTIGATOR_ARTIFACTS_DIR=cache/artifacts
# INVESTIGATOR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# INVESTIGATOR_TOP_K=10
# INVESTIGATOR_API_KEY=                        # if set, the API requires it as X-API-Key

# Optional LLM for root-cause hypotheses (POST /investigate with "hypotheses": true).
# Without it everything else works; the hypotheses step returns 503.
# INVESTIGATOR_LLM_KIND=anthropic              # or openai_compat (OpenAI, Ollama, vLLM, ...)
# INVESTIGATOR_LLM_MODEL=                      # REQUIRES YOUR DECISION: take the model id from your provider's docs
# INVESTIGATOR_LLM_BASE_URL=https://api.anthropic.com
# INVESTIGATOR_LLM_API_KEY_ENV=ANTHROPIC_API_KEY   # name of the env var that holds the key
# ANTHROPIC_API_KEY=
